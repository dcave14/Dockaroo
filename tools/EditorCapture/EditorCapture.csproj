<Project Sdk="Microsoft.NET.Sdk">

  <!-- Off-screen visual capture tool (TESTING.md). Not part of Dockaroo.sln; build the solution in
       Release first, then build this and run its exe with an output folder argument. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Dockaroo.Core">
      <HintPath>..\..\src\Dockaroo.App\bin\Release\net9.0-windows\Dockaroo.Core.dll</HintPath>
    </Reference>
    <Reference Include="Dockaroo">
      <HintPath>..\..\src\Dockaroo.App\bin\Release\net9.0-windows\Dockaroo.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
